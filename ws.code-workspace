{
    "folders": [
        {
            "path": "."
        }
    ],
    "extensions": {
        "recommendations": [
            "vscode.markdown-language-features",
            "streetsidesoftware.code-spell-checker",
            "vscode.git",
            "vscode.json-language-features",
            "DavidAnson.vscode-markdownlint",
            "vscode.markdown-math",
            "charliermarsh.ruff",
            "redhat.vscode-yaml"
        ]
    },
    "settings": {
        "workbench.startupEditor": "none", // prevent welcome page
        "cSpell.enabled": false,
        // -------------------------
        // Editor (GLOBAL)
        // -------------------------
        "files.autoSave": "afterDelay",
        "editor.formatOnSave": true,
        "editor.wordWrap": "bounded",
        "git.openRepositoryInParentFolders": "always",
        "editor.rulers": [
            97
        ],
        "editor.wordWrapColumn": 97,
        "files.eol": "\n",
        "editor.minimap.enabled": false,
        "editor.quickSuggestions": {
            "other": false,
            "comments": false,
            "strings": false,
        },
        // -------------------------
        // Python
        // -------------------------
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        // -------------------------
        // Markdown
        // -------------------------
        "[markdown]": {
            "editor.formatOnSave": true,
            "editor.formatOnPaste": true,
        },
        // -------------------------
        // Yaml
        // -------------------------
        "yaml.schemas": {
            "./.schema/kipe.schema.json": "**/study.yaml"
        },
        "files.exclude": {
            "**/.mypy_cache": true,
            "**/.pytest_cache": true,
            "**/.ruff_cache": true,
            "**/__pycache__": true,
            "build": true
        },
        "search.exclude": {
            "**/.mypy_cache": true,
            "**/.pytest_cache": true,
            "**/.ruff_cache": true,
            "**/__pycache__": true,
            "build": true
        },
        "files.watcherExclude": {
            "**/.mypy_cache/**": true,
            "**/.pytest_cache/**": true,
            "**/.ruff_cache/**": true,
            "**/__pycache__/**": true,
            "build": true
        }
    }
}
